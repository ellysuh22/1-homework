### [2] 내가 직접 작성한 Dockerfile 전문

$ cat Dockerfile
# =============================================================================
#  커스텀 웹서버 이미지  (미션 4장 "커스텀 이미지 제작" — 방식 (A) 선택)
#  방식 (A): 웹 서버 베이스 이미지 활용 + 정적 콘텐츠 / 설정 교체
# =============================================================================
#  베이스 이미지를 nginx:1.29-alpine 으로 "마이너 버전까지 고정"한 이유:
#    nginx:alpine 처럼 움직이는 태그를 쓰면 나중에 빌드했을 때 다른 버전이
#    받아져서 결과가 달라진다. 미션이 요구하는 "재현 가능한 환경"을 위해
#    버전을 못 박는다.
# =============================================================================
FROM nginx:1.29-alpine

# -----------------------------------------------------------------------------
# [커스텀 ①] 이미지 메타데이터
#   이 이미지가 무엇인지 이미지 자체에 새겨둔다.
#   docker inspect 로 확인할 수 있어, 나중에 이미지가 쌓였을 때 출처를 추적할 수 있다.
# -----------------------------------------------------------------------------
LABEL org.opencontainers.image.title="my-web" \
      org.opencontainers.image.description="개발 워크스테이션 구축 미션 - 커스텀 nginx 이미지" \
      org.opencontainers.image.version="1.0"

# -----------------------------------------------------------------------------
# [커스텀 ②] 설정값을 코드에서 분리 (ARG → ENV)
#   ARG : 빌드 시점 값. docker build --build-arg 로 변경 가능.
#   ENV : 실행 시점 값. docker run -e 로 변경 가능.
#   기본값을 80/dev 로 두었으므로, 아무 옵션 없이 실행하면 평범한 nginx와 똑같이 동작한다.
#
#   NGINX_ENVSUBST_FILTER 는 "APP_ 로 시작하는 환경변수만 치환하라"는 안전장치다.
#   이걸 비워두면 $PATH, $HOSTNAME 같은 시스템 변수까지 치환 대상이 되어 사고가 난다.
# -----------------------------------------------------------------------------
ARG APP_PORT=80
ARG APP_ENV=dev
ENV APP_PORT=${APP_PORT} \
    APP_ENV=${APP_ENV} \
    NGINX_ENVSUBST_FILTER="^APP_"

# -----------------------------------------------------------------------------
# [커스텀 ③] 정적 콘텐츠 교체
#   nginx 기본 환영 페이지를 내가 만든 페이지로 덮어쓴다.
# -----------------------------------------------------------------------------
COPY app/ /usr/share/nginx/html/

# -----------------------------------------------------------------------------
# [커스텀 ④] 서버 설정 교체 (템플릿 주입)
#   이미지에 원래 있던 /etc/nginx/conf.d/default.conf 는
#   listen 80 이 하드코딩돼 있어 환경변수로 바꿀 수 없다.
#   템플릿을 넣어두면 컨테이너 시작 시 envsubst 가 치환해서 새 default.conf 를 만든다.
# -----------------------------------------------------------------------------
COPY templates/ /etc/nginx/templates/

# -----------------------------------------------------------------------------
# [커스텀 ⑤] 사용 포트 선언
#   EXPOSE 는 "이 컨테이너는 이 포트를 쓸 예정"이라는 문서일 뿐,
#   실제로 외부에 열어주는 것은 docker run -p 다. (README 15-4절에서 설명)
# -----------------------------------------------------------------------------
EXPOSE ${APP_PORT}

# -----------------------------------------------------------------------------
# [커스텀 ⑥] 헬스체크
#   컨테이너가 "떠 있는 것"과 "정상 응답하는 것"은 다르다.
#   Docker가 10초마다 실제로 HTTP 요청을 보내 상태를 판정하게 한다.
#
#   주의 1: nginx:alpine 에는 curl 이 없다. busybox 내장 wget 을 쓴다.
#   주의 2: 반드시 shell 형식(CMD 뒤에 문자열)으로 써야 ${APP_PORT} 가
#           "실행 시점" 값으로 확장된다. exec 형식 ["wget", ...] 은 확장되지 않는다.
# -----------------------------------------------------------------------------
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null "http://127.0.0.1:${APP_PORT}/" || exit 1

# -----------------------------------------------------------------------------
#  CMD 는 베이스 이미지 기본값(nginx -g "daemon off;")을 그대로 물려받는다.
#
#  ※ 절대 CMD 를 덮어쓰지 말 것.
#    공식 엔트리포인트는 첫 인자가 nginx 일 때만 /docker-entrypoint.d/*.sh 를 실행한다.
#    CMD 를 sh -c "..." 등으로 바꾸면 템플릿 치환이 조용히 건너뛰어지고
#    포트가 80 에서 바뀌지 않는다. (에러도 안 나서 원인 찾기가 매우 어렵다)
# -----------------------------------------------------------------------------

### [3] nginx 설정 템플릿 — listen 포트를 환경변수로 받는 부분이 핵심

$ cat templates/default.conf.template
# =============================================================================
#  nginx 설정 "템플릿"
# =============================================================================
#  이 파일은 완성된 설정 파일이 아니라 템플릿이다.
#  컨테이너가 시작될 때 nginx 공식 이미지의 엔트리포인트 스크립트
#  (/docker-entrypoint.d/20-envsubst-on-templates.sh)가
#
#      /etc/nginx/templates/default.conf.template
#        --(envsubst 로 ${APP_*} 치환)-->
#      /etc/nginx/conf.d/default.conf
#
#  로 변환해 준다. 그래서 listen 포트를 코드 수정 없이 환경변수로 바꿀 수 있다.
#
#  주의: Dockerfile에서 NGINX_ENVSUBST_FILTER="^APP_" 를 지정했기 때문에
#        치환 대상은 APP_ 로 시작하는 변수뿐이다.
#        $uri, $host 같은 nginx 자체 변수는 그대로 살아남는다.
# =============================================================================

server {
    listen       ${APP_PORT};
    server_name  localhost;

    # 환경변수가 실제로 반영됐다는 증거 ①: 응답 헤더
    add_header X-App-Env  "${APP_ENV}"  always;
    add_header X-App-Port "${APP_PORT}" always;

    location / {
        root  /usr/share/nginx/html;
        index index.html;
    }

    # 환경변수가 실제로 반영됐다는 증거 ②: 전용 엔드포인트
    location = /env {
        default_type text/plain;
        return 200 "APP_ENV=${APP_ENV}\nAPP_PORT=${APP_PORT}\n";
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}

