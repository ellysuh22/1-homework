# =============================================================================
#  nginx 설정 "템플릿"
# =============================================================================
#  이 파일은 완성된 설정 파일이 아니라 템플릿이다.
#  컨테이너가 시작될 때 nginx 공식 이미지의 엔트리포인트 스크립트
#  (/docker-entrypoint.d/20-envsubst-on-templates.sh)가
#
#      /etc/nginx/templates/default.conf.template
#        --(envsubst 로 ${APP_*} 치환)-->
#      /etc/nginx/conf.d/default.conf
#
#  로 변환해 준다. 그래서 listen 포트를 코드 수정 없이 환경변수로 바꿀 수 있다.
#
#  주의: Dockerfile에서 NGINX_ENVSUBST_FILTER="^APP_" 를 지정했기 때문에
#        치환 대상은 APP_ 로 시작하는 변수뿐이다.
#        $uri, $host 같은 nginx 자체 변수는 그대로 살아남는다.
# =============================================================================

server {
    listen       ${APP_PORT};
    server_name  localhost;

    # 환경변수가 실제로 반영됐다는 증거 ①: 응답 헤더
    add_header X-App-Env  "${APP_ENV}"  always;
    add_header X-App-Port "${APP_PORT}" always;

    location / {
        root  /usr/share/nginx/html;
        index index.html;
    }

    # 환경변수가 실제로 반영됐다는 증거 ②: 전용 엔드포인트
    location = /env {
        default_type text/plain;
        return 200 "APP_ENV=${APP_ENV}\nAPP_PORT=${APP_PORT}\n";
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
