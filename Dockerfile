# =============================================================================
#  커스텀 웹서버 이미지 Dockerfile
#  미션 4장 「커스텀 이미지 제작」 — 방식 (A) 선택
#    (A) 웹 서버 베이스 이미지 활용 + 정적 콘텐츠 / 설정만 교체
# =============================================================================
#
#  [Dockerfile 이란?]
#    이미지를 "어떻게 만들지" 순서대로 적어둔 레시피 파일이다.
#    docker build 명령이 이 파일을 위에서 아래로 한 줄씩 실행해 이미지를 만든다.
#
#        Dockerfile  --(docker build)-->  이미지  --(docker run)-->  컨테이너
#          (레시피)                        (틀)                    (실행 중인 것)
#
#  [문법 기본]
#    · 맨 앞이 대문자인 단어(FROM, COPY 등)가 "지시어(instruction)"다.
#    · # 로 시작하는 줄은 주석이며 빌드에 아무 영향을 주지 않는다.
#    · 줄 끝의 \ 는 "다음 줄까지가 한 명령"이라는 뜻이다. (줄바꿈 이어쓰기)
#    · 지시어 하나가 이미지의 "층(layer)" 하나를 만든다. 층은 캐시되므로,
#      자주 바뀌는 내용을 뒤쪽에 둘수록 재빌드가 빨라진다.
# =============================================================================


# -----------------------------------------------------------------------------
#  FROM — 어떤 이미지를 출발점으로 삼을지 지정한다. (반드시 첫 지시어)
# -----------------------------------------------------------------------------
#  읽는 법:  FROM <이미지이름>:<태그>
#              └ nginx      : 웹서버 nginx 가 이미 설치된 공식 이미지
#              └ 1.29-alpine: 태그(=버전 라벨). nginx 1.29 버전 + Alpine 리눅스 기반
#
#  · Alpine 리눅스는 용량을 극단적으로 줄인 초경량 배포판이다.
#    같은 nginx 라도 Debian 기반은 약 200MB, Alpine 기반은 약 50MB 수준이다.
#    작을수록 내려받기·빌드·배포가 빠르다.
#
#  · 이미지 이름 앞에 주소가 없으면 Docker Hub(docker.io)에서 찾아온다.
#    즉 nginx:1.29-alpine 은 docker.io/library/nginx:1.29-alpine 의 줄임말이다.
#
#  [왜 태그를 1.29 까지 못 박았나]
#    nginx:alpine 처럼 버전 없는 태그는 "그때그때 최신"을 가리키는 움직이는 표적이다.
#    오늘 내 컴퓨터와 다음 달 평가자 컴퓨터가 서로 다른 버전을 받게 되어
#    결과가 달라질 수 있다. 미션이 요구하는 "재현 가능한 환경"과 정면으로 어긋나므로
#    마이너 버전까지 고정했다.
# -----------------------------------------------------------------------------
FROM nginx:1.29-alpine


# -----------------------------------------------------------------------------
#  [커스텀 ①]  LABEL — 이미지에 설명표(메타데이터)를 붙인다.
# -----------------------------------------------------------------------------
#  읽는 법:  LABEL <키>="<값>"  <키>="<값>" ...
#
#  · 이미지 자체에 새겨지는 정보라, 나중에 이미지가 수십 개로 늘어났을 때
#    "이건 누가 왜 만든 이미지인가"를 추적할 수 있다.
#  · 확인 명령:  docker inspect my-web:1.0 --format '{{json .Config.Labels}}'
#  · 프로그램 동작에는 아무 영향이 없다. 순수하게 기록용이다.
#
#  · org.opencontainers.image.* 라는 긴 이름은 마음대로 지은 게 아니라
#    OCI(Open Container Initiative)라는 컨테이너 표준 단체가 정한 공식 키 이름이다.
#    표준을 따르면 다른 도구들이 이 값을 자동으로 읽어 활용할 수 있다.
#
#  · 각 줄 끝의 \ 는 아래 줄까지 한 명령으로 이어붙이라는 표시다.
#    셋으로 나눠 쓰지 않고 하나로 묶으면 이미지 층이 1개만 생겨 더 효율적이다.
# -----------------------------------------------------------------------------
LABEL org.opencontainers.image.title="my-web" \
      org.opencontainers.image.description="개발 워크스테이션 구축 미션 - 커스텀 nginx 이미지" \
      org.opencontainers.image.version="1.0"


# -----------------------------------------------------------------------------
#  [커스텀 ②]  ARG / ENV — 설정값을 코드에서 분리한다.
# -----------------------------------------------------------------------------
#  ARG 와 ENV 는 둘 다 "변수"를 만들지만 살아있는 시점이 다르다.
#
#    ARG : 빌드하는 동안에만 존재한다. 이미지가 완성되면 사라진다.
#          바꾸는 법 →  docker build --build-arg APP_PORT=3000 .
#
#    ENV : 이미지에 저장되어 컨테이너가 실행될 때까지 살아남는다.
#          바꾸는 법 →  docker run -e APP_PORT=3000 my-web:1.0
#
#  그래서 아래처럼 ARG 로 기본값을 받고 ENV 로 옮겨 담으면
#  "빌드할 때도 바꿀 수 있고, 실행할 때도 바꿀 수 있는" 값이 된다.
#
#  · ${APP_PORT} 는 "APP_PORT 라는 변수의 값을 여기에 끼워 넣어라"는 뜻이다.
#    ARG APP_PORT=80 이 있으므로 ENV APP_PORT=${APP_PORT} 는 결국 ENV APP_PORT=80 이 된다.
#
#  · 기본값을 80/dev 로 두었기 때문에, 아무 옵션 없이 그냥 실행하면
#    평범한 nginx 와 똑같이 동작한다. 옵션은 필요할 때만 주면 된다.
#
#  [왜 이렇게까지 하나 — 설정과 코드의 분리]
#    포트를 설정 파일에 80 이라고 직접 박아두면, 포트를 바꾸려 할 때마다
#    파일을 고치고 이미지를 다시 빌드해야 한다.
#    바깥에서 주입할 수 있게 만들어 두면 이미지는 그대로 두고
#    실행 명령만 바꿔서 다르게 동작시킬 수 있다.
#
#  [NGINX_ENVSUBST_FILTER 는 안전장치다]
#    nginx 공식 이미지는 시작할 때 설정 템플릿 안의 ${변수} 를 실제 값으로 바꿔준다.
#    그런데 이 필터를 비워두면 컨테이너의 "모든" 환경변수가 치환 대상이 된다.
#    그러면 $PATH, $HOSTNAME 같은 시스템 변수까지 건드려 설정이 깨질 수 있다.
#    "^APP_" 는 정규식으로 "APP_ 로 시작하는 이름만"이라는 뜻이다.
#      ^   = 문자열의 시작
#      APP_= 그 뒤에 와야 할 글자
#    덕분에 APP_PORT, APP_ENV 만 치환되고 나머지는 안전하게 보호된다.
# -----------------------------------------------------------------------------
ARG APP_PORT=80
ARG APP_ENV=dev
ENV APP_PORT=${APP_PORT} \
    APP_ENV=${APP_ENV} \
    NGINX_ENVSUBST_FILTER="^APP_"


# -----------------------------------------------------------------------------
#  [커스텀 ③]  COPY — 내 컴퓨터의 파일을 이미지 안으로 복사한다.
# -----------------------------------------------------------------------------
#  읽는 법:  COPY <내 컴퓨터 경로> <이미지 안 경로>
#              └ app/                        : 이 Dockerfile 이 있는 폴더 기준 상대경로
#              └ /usr/share/nginx/html/      : 이미지 안의 절대경로
#
#  · 왼쪽 경로는 "빌드 컨텍스트"(docker build 명령 끝의 . 이 가리키는 폴더)를
#    기준으로 한다. 그 바깥의 파일(예: ../secret)은 보안상 복사할 수 없다.
#
#  · 양쪽 끝의 / 는 "폴더"라는 표시다. app/ 안의 내용물이
#    /usr/share/nginx/html/ 안으로 들어간다. (app 폴더 자체가 들어가는 게 아니다)
#
#  · /usr/share/nginx/html 은 nginx 가 웹페이지를 찾는 기본 위치다.
#    원래 이 자리에는 nginx 기본 환영 페이지가 있는데, 같은 이름의 파일을
#    덮어쓰면서 내가 만든 페이지로 교체된다.
#    → 이것이 미션 (A) 방식이 요구하는 "정적 콘텐츠 교체"다.
#
#  · 참고: .dockerignore 파일에 적힌 것들(logs/, evidence/, *.md 등)은
#    빌드 컨텍스트에서 아예 제외되어 이미지에 들어가지 않는다.
# -----------------------------------------------------------------------------
COPY app/ /usr/share/nginx/html/


# -----------------------------------------------------------------------------
#  [커스텀 ④]  COPY — nginx 서버 설정을 "템플릿"으로 넣는다.
# -----------------------------------------------------------------------------
#  이 COPY 는 위의 COPY 와 문법은 같지만 목적이 전혀 다르다.
#  위가 "보여줄 내용(HTML)"이라면, 이것은 "서버를 어떻게 굴릴지(설정)"다.
#
#  [왜 완성된 설정 파일이 아니라 템플릿인가]
#    이미지에 원래 들어있는 /etc/nginx/conf.d/default.conf 에는
#    listen 80; 이 글자 그대로 박혀 있다. 그래서 환경변수를 아무리 줘도
#    nginx 는 계속 80번만 듣는다.
#
#    반면 /etc/nginx/templates/ 폴더는 특별 취급을 받는다.
#    nginx 공식 이미지에는 시작할 때 자동 실행되는 스크립트가 들어 있는데
#    (/docker-entrypoint.d/20-envsubst-on-templates.sh),
#    이 스크립트가 아래 작업을 대신 해준다.
#
#        /etc/nginx/templates/default.conf.template
#              │
#              │  envsubst 로 ${APP_PORT} → 80 처럼 실제 값으로 치환
#              ▼
#        /etc/nginx/conf.d/default.conf      ← 원래 있던 파일을 덮어씀
#
#    즉 컨테이너가 켜지는 순간 설정 파일이 새로 만들어진다.
#    덕분에 이미지를 다시 빌드하지 않고도 포트를 바꿀 수 있다.
#
#  · 실제로 치환됐는지 확인하는 명령:
#      docker exec <컨테이너> cat /etc/nginx/conf.d/default.conf
#      docker logs <컨테이너>     ← "Running envsubst on ..." 문구가 보인다
# -----------------------------------------------------------------------------
COPY templates/ /etc/nginx/templates/


# -----------------------------------------------------------------------------
#  [커스텀 ⑤]  EXPOSE — 이 컨테이너가 쓸 포트를 "선언"한다.
# -----------------------------------------------------------------------------
#  읽는 법:  EXPOSE <포트번호>
#
#  ※ 가장 오해하기 쉬운 지시어다. EXPOSE 는 포트를 열어주지 않는다.
#
#    EXPOSE 는 "이 컨테이너는 이 포트를 씁니다"라고 적어두는 문서일 뿐이다.
#    실제로 바깥(내 맥)에서 접속할 수 있게 다리를 놓는 것은 오직
#    docker run 의 -p 옵션이다.
#
#        docker run -d -p 8080:80 my-web:1.0
#                         └───┬──┘
#                   호스트 8080 → 컨테이너 80 으로 연결
#
#    EXPOSE 만 있고 -p 가 없으면 컨테이너 안에서는 nginx 가 멀쩡히 돌지만
#    호스트에서는 접속이 거부된다. (README 15-4절에서 직접 실험으로 증명함)
#
#  · 주의: 여기 들어가는 ${APP_PORT} 는 "빌드 시점" 값(80)으로 고정된다.
#    나중에 docker run -e APP_PORT=3000 으로 실행해도
#    docker inspect 의 ExposedPorts 는 여전히 80 으로 표시된다.
#    이것은 버그가 아니라, EXPOSE 가 애초에 문서용이기 때문이다.
# -----------------------------------------------------------------------------
EXPOSE ${APP_PORT}


# -----------------------------------------------------------------------------
#  [커스텀 ⑥]  HEALTHCHECK — 컨테이너가 "정상 응답하는지" 주기적으로 점검한다.
# -----------------------------------------------------------------------------
#  컨테이너가 "떠 있는 것"과 "제대로 응답하는 것"은 다르다.
#  프로세스는 살아있는데 내부 오류로 에러만 뱉는 상태일 수도 있다.
#  HEALTHCHECK 를 걸어두면 Docker 가 주기적으로 실제 요청을 보내 판정해 준다.
#
#  옵션 하나씩:
#    --interval=10s      10초마다 한 번씩 검사한다.
#    --timeout=3s        검사 명령이 3초 안에 안 끝나면 실패로 친다.
#    --start-period=5s   컨테이너가 막 켜진 직후 5초 동안은 실패해도 봐준다.
#                        (서버가 준비되는 시간을 주는 것. 이 구간은 unhealthy 로 안 센다)
#    --retries=3         연속 3번 실패해야 비로소 unhealthy 로 판정한다.
#                        (일시적인 한 번의 실패로 오판하지 않기 위함)
#
#  검사 명령 뜯어보기:
#    wget -q -O /dev/null "http://127.0.0.1:${APP_PORT}/" || exit 1
#         │  │            │                                │
#         │  │            │                                └ 앞이 실패하면 종료코드 1
#         │  │            │                                  (Docker 는 0=정상, 1=실패로 읽는다)
#         │  │            └ 자기 자신(127.0.0.1)에게 요청. 컨테이너 안에서 실행되므로
#         │  │              localhost 가 곧 이 컨테이너 자신이다.
#         │  └ -O /dev/null : 받아온 내용을 저장하지 않고 버린다.
#         │                   (응답이 오는지만 확인하면 되므로 파일로 남길 필요 없음)
#         └ -q : quiet. 진행 상황 메시지를 출력하지 않는다.
#
#  [주의 1] nginx:alpine 에는 curl 이 없다.
#    Alpine 은 용량을 줄이려고 최소한의 도구만 담고 있다.
#    대신 busybox 에 내장된 wget 이 있으므로 그것을 썼다.
#    (curl 을 쓰려면 RUN apk add --no-cache curl 로 따로 설치해야 하는데,
#     빌드 시간과 실패 위험이 늘어나므로 이미 있는 도구를 택했다.)
#
#  [주의 2] 반드시 shell 형식으로 써야 한다.
#    지금처럼 CMD 뒤에 문자열을 쓰면 셸이 명령을 해석하므로
#    ${APP_PORT} 가 실행 시점의 실제 값으로 치환된다.
#    반면 CMD ["wget", "http://127.0.0.1:${APP_PORT}/"] 같은 배열(exec) 형식은
#    셸을 거치지 않아 ${APP_PORT} 가 글자 그대로 남아 검사가 항상 실패한다.
#
#  · 상태 확인 명령:
#      docker inspect <컨테이너> --format '{{.State.Health.Status}}'
#        → starting  (아직 판정 전)
#        → healthy   (정상 응답)
#        → unhealthy (연속 실패)
#      docker ps 의 STATUS 칸에도 Up 12 seconds (healthy) 처럼 함께 표시된다.
# -----------------------------------------------------------------------------
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null "http://127.0.0.1:${APP_PORT}/" || exit 1


# =============================================================================
#  CMD 를 적지 않은 이유 — 베이스 이미지의 기본값을 그대로 물려받는다
# =============================================================================
#  CMD 는 "컨테이너가 시작될 때 실행할 명령"을 정하는 지시어다.
#  여기에 아무것도 안 썼으므로 nginx:1.29-alpine 이 갖고 있던 기본값
#  nginx -g "daemon off;" 가 그대로 사용된다.
#
#  ("daemon off" 는 nginx 를 백그라운드로 보내지 말고 화면 앞에 머물게 하라는 뜻이다.
#   컨테이너는 메인 프로세스가 끝나면 함께 종료되므로, 서버가 백그라운드로
#   빠져버리면 컨테이너가 곧바로 죽어버린다.)
#
#  ※※ 절대 CMD 를 덮어쓰지 말 것 ※※
#    nginx 공식 이미지의 시작 스크립트(docker-entrypoint.sh)는
#    "첫 번째 인자가 nginx 일 때만" /docker-entrypoint.d/*.sh 를 실행하도록 되어 있다.
#
#    그런데 CMD 를 sh -c "..." 같은 것으로 바꾸면 첫 인자가 sh 가 되어
#    그 조건을 통과하지 못한다. 그러면 [커스텀 ④]의 템플릿 치환 스크립트가
#    통째로 건너뛰어진다.
#
#    가장 고약한 점은 에러가 전혀 나지 않는다는 것이다.
#    컨테이너는 멀쩡히 뜨고, 페이지도 나오는데, 포트만 안 바뀐다.
#    원인을 찾기가 매우 어려우므로 미리 적어둔다.
# =============================================================================
