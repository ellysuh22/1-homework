# =============================================================================
#  빌드 컨텍스트에서 제외할 파일 목록
# =============================================================================
#  docker build 는 현재 폴더 전체를 Docker 데몬에 전송한 뒤 빌드한다.
#  이미지에 들어갈 필요 없는 파일(문서, 로그, 스크린샷, git 이력)을 빼면
#  전송량이 줄어 빌드가 빨라지고, 실수로 민감한 파일이 이미지에 섞여
#  들어가는 것도 막을 수 있다.
# =============================================================================

.git/
.gitignore

# 문서 / 증거물 — 이미지에 들어갈 이유가 없다
logs/
evidence/
scripts/
*.md
mission.txt
*.log

# 바인드 마운트 실습용 폴더 (실행 시점에 -v 로 연결하므로 이미지에는 불필요)
bindmount-demo/
practice/

.DS_Store

# -----------------------------------------------------------------------------
#  주의: app/ 과 templates/ 는 절대 제외하면 안 된다.
#        Dockerfile 의 COPY 대상이므로 제외하면 빌드가 실패한다.
# -----------------------------------------------------------------------------
